    },
    {
      "id": "HostFiles",
      "widgetTypeId": "list-box",
      "text": "",
      "x": 234,
      "y": 86,
      "width": 216,
      "height": 114,
      "properties": {
        "items": "Waiting for host listing"
      },
      "events": {
        "OnClick": "HostFilesClick"
      }
    },
    {
      "id": "RefreshMacButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 12,
      "y": 204,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "refresh"
      },
      "events": {
        "OnClick": "RefreshMacClick"
      }
    },
    {
      "id": "RefreshHostButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 196,
      "y": 204,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "refresh"
      },
      "events": {
        "OnClick": "RefreshHostClick"
      }
    },
    {
      "id": "TransferProgressBar",
      "widgetTypeId": "progress-bar",
      "text": "",
      "x": 12,
      "y": 264,
      "width": 438,
      "height": 14,
      "properties": {
        "value": "0"
      },
      "events": {}
    },
    {
      "id": "ActionStatus",
      "widgetTypeId": "static-text",
      "text": "Waiting for the REMOTE RetroLink session.",
      "x": 12,
      "y": 282,
      "width": 438,
      "height": 16,
      "properties": {},
      "events": {}
    },
    {
      "id": "CopyToHostButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 234,
      "y": 204,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "upload"
      },
      "events": {
        "OnClick": "CopyToDosClick"
      }
    },
    {
      "id": "CreateFolderButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 12,
      "y": 234,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "folder-plus"
      },
      "events": {
        "OnClick": "CreateMacFolderClick"
      }
    },
    {
      "id": "RenameEntryButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 40,
      "y": 234,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "pencil"
      },
      "events": {
        "OnClick": "RenameMacEntryClick"
      }
    },
    {
      "id": "DeleteEntryButton",
      "widgetTypeId": "button",
      "text": "",
      "x": 68,
      "y": 234,
      "width": 24,
      "height": 24,
      "properties": {
        "iconId": "delete"
      },
      "events": {
        "OnClick": "DeleteMacEntryClick"
      }
    }
  ],
  "components": [
    {
      "id": "SerialPort1",
      "componentTypeId": "serial-port",
      "properties": {
        "port": "Modem",
        "baud": "9600",
        "dataBits": "8",
        "parity": "None",
        "stopBits": "1",
        "flowControl": "None"
      },
      "events": {
        "OnDataAvailable": "SerialDataAvailable",
        "OnError": "SerialError"
      }
    },
    {
      "id": "ProtocolTransfer1",
      "componentTypeId": "protocol-transfer",
      "properties": {
        "serialPortId": "SerialPort1",
        "fileName": "TRANSFER.BIN",
        "protocol": "XmodemCRC",
        "timeoutSeconds": "10"
      },
      "events": {
        "OnProgress": "TransferProgress"
      }
    }
  ]
}
