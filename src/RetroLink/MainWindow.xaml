<Window x:Class="RetroLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroLink 0.1" Height="720" Width="1180"
        MinHeight="540" MinWidth="860"
        Closing="Window_Closing">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <ToolBarTray>
                <ToolBar>
                    <Button Content="Refresh Ports" Click="RefreshPorts_Click" />
                    <Separator />
                    <TextBlock Text="COM port:" VerticalAlignment="Center" Margin="4,0" />
                    <ComboBox x:Name="ComPortComboBox" Width="110" IsEditable="True" />
                    <TextBlock Text="Baud:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox x:Name="BaudRateComboBox" Width="100" SelectedIndex="8">
                        <ComboBoxItem Content="300" Tag="300" />
                        <ComboBoxItem Content="600" Tag="600" />
                        <ComboBoxItem Content="1200" Tag="1200" />
                        <ComboBoxItem Content="1800" Tag="1800" />
                        <ComboBoxItem Content="2400" Tag="2400" />
                        <ComboBoxItem Content="3600" Tag="3600" />
                        <ComboBoxItem Content="4800" Tag="4800" />
                        <ComboBoxItem Content="7200" Tag="7200" />
                        <ComboBoxItem Content="9600" Tag="9600" />
                        <ComboBoxItem Content="14400" Tag="14400" />
                        <ComboBoxItem Content="19200" Tag="19200" />
                        <ComboBoxItem Content="28800" Tag="28800" />
                        <ComboBoxItem Content="38400" Tag="38400" />
                        <ComboBoxItem Content="57600" Tag="57600" />
                    </ComboBox>
                    <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" />
                    <Button x:Name="DisconnectButton" Content="Disconnect"
                            Click="Disconnect_Click" IsEnabled="False" />
                    <Separator />
                    <Button x:Name="TakeControlButton" Content="Take Control"
                            Click="TakeControl_Click" IsEnabled="False" />
                    <Button x:Name="CopyToMacButton"
                            ToolBar.OverflowMode="Never"
                            ToolTip="Copy the selected local file to the open remote folder"
                            AutomationProperties.Name="Copy selected local file to REMOTE"
                            Click="CopyToMac_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE898;" Margin="0,0,6,0" />
                            <TextBlock Text="Copy to REMOTE" />
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="TransferProgressBar" Width="180" Height="16"
                                 Minimum="0" Maximum="100" Visibility="Collapsed"
                                 VerticalAlignment="Center" Margin="6,0" />
                    <TextBlock x:Name="RoleText" Text="Role: Disconnected"
                               VerticalAlignment="Center" Margin="8,0" />
                </ToolBar>
                <ToolBar>
                    <Button Content="Choose Local Root" Click="ChooseLocalRoot_Click" />
                    <Button Content="Up" Click="LocalUp_Click" />
                    <Button Content="Refresh" Click="RefreshLocal_Click" />
                    <Separator />
                    <Button Content="New Folder" Click="CreateDirectory_Click" />
                    <Button Content="Rename" Click="RenameEntry_Click" />
                    <Button Content="Delete" Click="DeleteEntry_Click" />
                    <TextBlock x:Name="LocalPathText" Text="Choose a local root folder"
                               VerticalAlignment="Center" Margin="8,0" />
                </ToolBar>
            </ToolBarTray>
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. COM30/COM31 are reserved for the MacStudio Agent." />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="LOCAL" Grid.Column="0" Margin="0,0,4,0">
                <DockPanel>
                    <TextBlock x:Name="LocalRootText" DockPanel.Dock="Top"
                               Margin="6" Text="No local root selected" />
                    <ListView x:Name="LocalFileListView"
                              ItemsSource="{Binding LocalEntries}"
                              SelectionChanged="FileSelection_Changed"
                              MouseDoubleClick="LocalFileListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="270"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Type" Width="90"
                                                DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Size" Width="100"
                                                DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn Header="Modified" Width="140"
                                                DisplayMemberBinding="{Binding Modified}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#B0B0B0" />

            <GroupBox Header="REMOTE" Grid.Column="2" Margin="4,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="6">
                        <DockPanel>
                            <Button x:Name="RemoteUpButton"
                                    Content="Up"
                                    ToolTip="Go up one level in the remote file list"
                                    AutomationProperties.Name="Go up one level in the remote file list"
                                    DockPanel.Dock="Right"
                                    Click="RemoteUp_Click"
                                    IsEnabled="False"
                                    Margin="8,0,0,0" />
                            <TextBlock x:Name="RemoteDeviceText"
                                       Text="Not connected to a REMOTE RetroLink peer"
                                       FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock x:Name="RemoteRootText"
                                   Text="Remote volumes will appear after the HELLO handshake."
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <ListView x:Name="RemoteFileListView"
                              ItemsSource="{Binding RemoteEntries}"
                              SelectionChanged="FileSelection_Changed"
                              MouseDoubleClick="RemoteFileListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Volume / Name" Width="270"
                                                DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Type" Width="90"
                                                DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="Size" Width="100"
                                                DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn Header="Modified" Width="140"
                                                DisplayMemberBinding="{Binding Modified}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
